// ── Node metrics ──────────────────────────────────────────────────────────────

prometheus.exporter.unix "node" {}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

// ── Remote write ───────────────────────────────────────────────────────────────

prometheus.remote_write "monitoring" {
  endpoint {
    url = "{{ alloy_prometheus_url }}"

    write_relabel_config {
      target_label = "environment"
      replacement  = "{{ env }}"
    }

    write_relabel_config {
      target_label = "hostname"
      replacement  = constants.hostname
    }

    write_relabel_config {
      target_label = "nodename"
      replacement  = "{{ node_group }}"
    }
  }
}


{% if nginx_status_url is defined %}
// ── Nginx metrics ──────────────────────────────────────────────────────────────

prometheus.scrape "nginx" {
  targets = [{
    __address__ = "localhost:9113",
    job         = "nginx",
    environment = "{{ env }}",
    hostname    = constants.hostname,
    nodename    = "{{ node_group }}",
  }]
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

{% endif %}
{% if haproxy_stats_addr is defined %}
// ── HAProxy metrics ────────────────────────────────────────────────────────────

prometheus.scrape "haproxy" {
  targets = [{
    __address__ = "localhost:9101",
    job         = "haproxy",
    environment = "{{ env }}",
    hostname    = constants.hostname,
    nodename    = "{{ node_group }}",
  }]
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

{% endif %}
{% if beyla_services is defined %}
// ── Beyla OTLP receiver ────────────────────────────────────────────────────────

otelcol.receiver.otlp "beyla" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }

  output {
    metrics = [otelcol.processor.transform.beyla.input]
{% if alloy_tempo_url is defined %}
    traces  = [otelcol.processor.transform.beyla.input, otelcol.connector.servicegraph.beyla.input]
{% endif %}
  }
}

{% if alloy_tempo_url is defined %}
otelcol.connector.servicegraph "beyla" {
  dimensions = ["http.method", "http.route"]
  output {
    metrics = [otelcol.processor.transform.beyla.input]
  }
}
{% endif %}

otelcol.processor.transform "beyla" {
  error_mode = "ignore"

  metric_statements {
    context    = "resource"
    statements = [
      `set(attributes["environment"], "{{ env }}")`,
      `set(attributes["nodename"], "{{ node_group }}")`,
    ]
  }

{% if alloy_tempo_url is defined %}
  trace_statements {
    context    = "resource"
    statements = [
      `set(attributes["environment"], "{{ env }}")`,
      `set(attributes["nodename"], "{{ node_group }}")`,
    ]
  }

  trace_statements {
    context    = "span"
    statements = [
      `set(name, Concat([name, " ", attributes["http.route"]], "")) where (name == "GET" or name == "POST" or name == "PUT" or name == "DELETE" or name == "PATCH") and attributes["http.route"] != nil`,
      `set(name, Concat([name, " ", attributes["url.path"]], "")) where (name == "GET" or name == "POST" or name == "PUT" or name == "DELETE" or name == "PATCH") and attributes["http.route"] == nil and attributes["url.path"] != nil`,
      `set(attributes["peer.service"], attributes["server.address"]) where (name == "GET" or name == "POST" or name == "PUT" or name == "DELETE" or name == "PATCH") and attributes["peer.service"] == nil and attributes["server.address"] != nil`,
    ]
  }

{% endif %}
  output {
    metrics = [otelcol.processor.batch.beyla.input]
{% if alloy_tempo_url is defined %}
    traces  = [otelcol.processor.filter.beyla.input]
{% endif %}
  }
}

{% if alloy_tempo_url is defined and trace_include_paths is defined %}
otelcol.processor.filter "beyla" {
  error_mode = "ignore"
  traces {
    span = [
      `attributes["url.path"] != nil and not ({% for path in trace_include_paths %}IsMatch(attributes["url.path"], "{{ path }}"){% if not loop.last %} or {% endif %}{% endfor %})`,
    ]
  }
  output {
    traces = [otelcol.processor.batch.beyla.input]
  }
}
{% endif %}

otelcol.processor.batch "beyla" {
  timeout = "2s"
  output {
    metrics = [otelcol.exporter.prometheus.beyla.input]
{% if alloy_tempo_url is defined %}
    traces  = [otelcol.exporter.otlphttp.tempo.input]
{% endif %}
  }
}

otelcol.exporter.prometheus "beyla" {
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

{% if alloy_tempo_url is defined %}
otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "{{ alloy_tempo_url }}"
    tls { insecure = true }
  }
}
{% endif %}
{% endif %}

discovery:
  services:
{% for svc in beyla_services %}
    - name: {{ svc.name }}
      open_ports: {{ svc.open_ports }}
{% endfor %}
  exclude:
    - exe_path: dockerd
    - exe_path: containerd
    - exe_path: docker-proxy

otel_metrics_export:
  endpoint: http://localhost:4318

{% if alloy_tempo_url is defined %}
otel_traces_export:
  endpoint: http://localhost:4318
{% endif %}

attributes:
  kubernetes:
    enable: false

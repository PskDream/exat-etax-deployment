services:
  {{ service_name }}:
    image: "{{ ecr_registry }}/{{ svc.repository }}:{{ image_tag }}"
    container_name: "{{ service_name }}"
    restart: always
    ports:
      - "{{ svc.app_port }}:{{ svc.container_port }}"
    environment:
      TZ: "Asia/Bangkok"
{% if svc.env_file is defined %}
    env_file:
{% for f in svc.env_file %}
      - "{{ f }}"
{% endfor %}
{% endif %}
{% if svc.volumes is defined %}
    volumes:
{% for v in svc.volumes %}
      - "{{ v }}"
{% endfor %}
{% endif %}
{% if svc.health_path is defined %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ svc.container_port }}{{ svc.health_path }}"]
      interval: 1m
      timeout: 5s
      retries: 3
      start_period: 15s
{% endif %}
{% if svc.nfs_server_ip is defined %}
volumes:
  nfs-data:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ svc.nfs_server_ip }},rw,sync,nfsvers=4
      device: ":{{ svc.nfs_device_path }}"
{% endif %}
